# Environment variables Turttyl reads. None are required.
# The app keeps its settings in ~/.turttyl/config.json, not here.

# Folder for config.json, audit.jsonl, the agent socket and shell integration files.
# Default: ~/.turttyl. Keep the path short: the socket path must be under 100 bytes.
TURTTYL_HOME=

# Name shown in the app for an agent connected through `turttyl mcp`.
# Default: the MCP client's own name (for example "claude-code").
TURTTYL_AGENT_NAME=

# Shell for new (non-elevated) sessions: zsh or bash. Default: your login shell.
SHELL=

# Tests only: set to 1 to run TestRealShell against your own shell setup (make test-real).
AT_REAL_SHELL_TEST=

# Development only (Wails): load the UI from a Vite dev server, e.g. http://localhost:5173
FRONTEND_DEVSERVER_URL=
